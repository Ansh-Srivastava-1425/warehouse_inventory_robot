<?xml version="1.0"?>
<robot name="warehouse_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Parameters (meters, kilograms) ===== -->
  <xacro:property name="chassis_x" value="0.60"/>
  <xacro:property name="chassis_y" value="0.40"/>
  <xacro:property name="chassis_z" value="0.12"/>
  <xacro:property name="chassis_mass" value="12.0"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.44"/>
  <xacro:property name="wheel_mass" value="0.8"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass" value="0.2"/>

  <!-- ===== Colors ===== -->
  <material name="graphite"><color rgba="0.169 0.184 0.212 1.0"/></material>
  <material name="deck_grey"><color rgba="0.35 0.38 0.42 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.416 0.0 1.0"/></material>
  <material name="tire_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="mast_grey"><color rgba=".75 0.77 0.80 1.0"/></material>

  <!-- ===== Inertia helpers ===== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12.0}" iyz="0"
             izz="${m*(x*x+y*y)/12.0}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12.0}" iyz="0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2.0*m*r*r/5.0}" ixy="0" ixz="0"
             iyy="${2.0*m*r*r/5.0}" iyz="0"
             izz="${2.0*m*r*r/5.0}"/>
  </xacro:macro>

  <!-- ===== Base: footprint (on the floor) and chassis ===== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="graphite"/>
    </visual>
    <visual>
      <!-- orange accent stripe around the body -->
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="${chassis_x+0.004} ${chassis_y+0.004} 0.015"/></geometry>
      <material name="orange"/>
    </visual>
    <visual>
      <!-- top deck -->
      <origin xyz="0 0 ${chassis_z/2+0.005}" rpy="0 0 0"/>
      <geometry><box size="0.50 0.35 0.01"/></geometry>
        <material name="deck_grey"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}"/>
    </inertial>
  </link>

  <!-- ===== Drive wheels ===== -->
  <xacro:macro name="drive_wheel" params="name y">
    <link name="${name}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tire_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="left" y="${wheel_separation/2}"/>
  <xacro:drive_wheel name="right" y="${-wheel_separation/2}"/>

  <!-- ===== Caster balls (front and back) ===== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="tire_black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${-(wheel_radius-caster_radius)}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front" x="0.22"/>
  <xacro:caster name="back" x="-0.22"/>

  <!-- Lidar Sensor -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <xacro:cylinder_inertia m="0.3" r="0.05" h="0.05"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0 0.095" rpy="0 0 0"/>
  </joint>

    <!-- Scanner mast -->
  <link name="mast_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.80"/>
      </geometry>
      <material name="mast_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.80"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <xacro:box_inertia m="0.5" x="0.04" y="0.04" z="0.80"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="-0.20 0 0.47" rpy="0 0 0"/>
  </joint>

</robot>
